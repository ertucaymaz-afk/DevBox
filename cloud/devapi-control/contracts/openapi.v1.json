{
  "openapi": "3.1.0",
  "info": {
    "title": "DevAPI Control Plane",
    "version": "0.1.20",
    "description": "DevAPI control-plane ve autonomous-engineering source contract. Source contract runtime veya production doğrulaması anlamına gelmez."
  },
  "servers": [{ "url": "https://devapi-virid.vercel.app", "description": "Historical canonical target; runtime state must be verified separately." }],
  "x-devapi-runtime-state": "STALE",
  "paths": {
    "/api/v1/agent-approvals": {
      "get": {
        "operationId": "listAgentApprovals",
        "summary": "List persisted scoped approvals",
        "security": [{ "adminToken": [] }],
        "responses": {
          "200": { "description": "Approval list" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/BlockedExternal" }
        }
      },
      "post": {
        "operationId": "createOrDecideAgentApproval",
        "summary": "Create or decide a scoped approval with replay protection",
        "security": [{ "adminToken": [] }],
        "responses": {
          "200": { "description": "Approval decided" },
          "201": { "description": "Approval requested" },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "503": { "$ref": "#/components/responses/BlockedExternal" }
        }
      }
    },
    "/api/v1/agent-capabilities": {
      "get": {
        "operationId": "getAgentCapabilities",
        "summary": "Autonomous engineering capability truth state",
        "security": [{ "adminToken": [] }],
        "responses": { "200": { "description": "Source/runtime capability states" }, "401": { "description": "Unauthorized" }, "503": { "description": "Control plane unconfigured" } }
      }
    },
    "/api/v1/agent-orchestrator": {
      "post": {
        "operationId": "runAgentOrchestrator",
        "summary": "Advance a persisted task through bounded triage and real planner execution",
        "security": [{ "adminToken": [] }],
        "responses": {
          "200": { "description": "Task orchestration advanced" },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Task not found" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "503": { "$ref": "#/components/responses/BlockedExternal" },
          "504": { "description": "Runtime timeout" }
        }
      }
    },
    "/api/v1/agent-research": {
      "get": {
        "operationId": "getAgentResearchState",
        "summary": "Web research provider configuration truth state",
        "security": [{ "adminToken": [] }],
        "responses": { "200": { "description": "Research provider state" }, "401": { "description": "Unauthorized" }, "503": { "description": "Control plane unconfigured" } }
      },
      "post": {
        "operationId": "runAgentResearch",
        "summary": "Run bounded primary-source-first web research",
        "security": [{ "adminToken": [] }],
        "responses": { "200": { "description": "Research result with provider evidence URLs" }, "400": { "description": "Invalid research request" }, "401": { "description": "Unauthorized" }, "502": { "description": "Research provider failure" }, "503": { "description": "External provider credential unconfigured" } }
      }
    },
    "/api/v1/agent-runtime": {
      "get": {
        "operationId": "getAgentRuntimeState",
        "summary": "Agent runtime dependency and credential truth state",
        "security": [{ "adminToken": [] }],
        "responses": { "200": { "description": "Agent runtime source/configuration state" }, "401": { "description": "Unauthorized" } }
      },
      "post": {
        "operationId": "runAgentPlanner",
        "summary": "Run the real planner agent for a persisted task when provider requirements are available",
        "security": [{ "adminToken": [] }],
        "responses": { "200": { "description": "Planner output and evidence digest" }, "400": { "description": "Invalid task or state" }, "401": { "description": "Unauthorized" }, "404": { "description": "Task not found" }, "503": { "description": "SDK, provider credential, or database unconfigured" }, "504": { "description": "Agent runtime timeout" } }
      }
    },
    "/api/v1/agent-tasks": {
      "get": {
        "operationId": "listOrGetAgentTasks",
        "summary": "List agent tasks or read one task with its append-only events and evidence",
        "security": [{ "adminToken": [] }],
        "responses": { "200": { "description": "Task list or task detail" }, "401": { "description": "Unauthorized" }, "404": { "description": "Task not found" }, "503": { "description": "Database unconfigured" } }
      },
      "post": {
        "operationId": "createAgentTask",
        "summary": "Create a persisted task and classify its risk",
        "security": [{ "adminToken": [] }],
        "responses": { "201": { "description": "Task created in CREATED state" }, "400": { "description": "Invalid task input" }, "401": { "description": "Unauthorized" }, "503": { "description": "Database unconfigured" } }
      },
      "patch": {
        "operationId": "transitionAgentTask",
        "summary": "Apply a validated append-only task state transition",
        "security": [{ "adminToken": [] }],
        "responses": { "200": { "description": "Task transitioned" }, "400": { "description": "Invalid transition request" }, "401": { "description": "Unauthorized" }, "404": { "description": "Task not found" }, "409": { "description": "Transition denied by state machine" }, "503": { "description": "Database unconfigured" } }
      }
    },
    "/api/v1/commands": {
      "get": { "operationId": "listDesktopCommands", "summary": "List commands for authenticated desktop", "security": [{ "desktopSignature": [] }], "responses": { "200": { "description": "Commands" }, "401": { "description": "Unauthorized" } } },
      "post": { "operationId": "createDesktopCommand", "summary": "Create allow-listed command", "security": [{ "adminToken": [] }], "responses": { "201": { "description": "Created" }, "400": { "description": "Invalid command" }, "401": { "description": "Unauthorized" } } },
      "patch": { "operationId": "ackDesktopCommand", "summary": "Acknowledge command execution", "security": [{ "desktopSignature": [] }], "responses": { "200": { "description": "Acknowledged" }, "400": { "description": "Invalid acknowledgement" }, "401": { "description": "Unauthorized" }, "404": { "description": "Command not found" } } }
    },
    "/api/v1/health": { "get": { "operationId": "getHealth", "summary": "Control-plane configuration health", "responses": { "200": { "description": "Configured" }, "503": { "description": "Unconfigured" } } } },
    "/api/v1/product-links": { "get": { "operationId": "getProductLinks", "summary": "Sanitized public product origins", "responses": { "200": { "description": "Configured public links" }, "503": { "description": "Links unconfigured" } } } },
    "/api/v1/projects": { "get": { "operationId": "listProjects", "summary": "List control-plane projects", "security": [{ "adminToken": [] }], "responses": { "200": { "description": "Projects" }, "401": { "description": "Unauthorized" }, "503": { "description": "Database unconfigured" } } } },
    "/api/v1/public-state": {
      "get": { "operationId": "getPublicState", "summary": "Sanitized project state", "responses": { "200": { "description": "Sanitized state" }, "404": { "description": "Project not found" }, "409": { "description": "Project selection ambiguous" }, "503": { "description": "Control plane unconfigured" } } },
      "options": { "operationId": "optionsPublicState", "summary": "Public-state CORS preflight", "responses": { "204": { "description": "No content" } } }
    },
    "/api/v1/snapshot": { "post": { "operationId": "saveSnapshot", "summary": "Persist authenticated desktop snapshot", "security": [{ "desktopSignature": [] }], "responses": { "202": { "description": "Accepted" }, "400": { "description": "Invalid snapshot" }, "401": { "description": "Unauthorized" }, "503": { "description": "Database/auth unconfigured" } } } },
    "/api/v1/state": { "get": { "operationId": "getProjectState", "summary": "Read authenticated project state", "security": [{ "adminToken": [] }], "responses": { "200": { "description": "Project state" }, "400": { "description": "Invalid project id" }, "401": { "description": "Unauthorized" }, "503": { "description": "Database unconfigured" } } } }
  },
  "components": {
    "schemas": {
      "ErrorEnvelopeV2": {
        "type": "object",
        "required": ["error", "requestId"],
        "properties": {
          "requestId": { "type": "string" },
          "error": {
            "type": "object",
            "required": ["code", "state", "message", "requestId", "retryable"],
            "properties": {
              "code": { "type": "string" },
              "state": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" },
              "retryable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "responses": {
      "InvalidRequest": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeV2" } } } },
      "Unauthorized": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeV2" } } } },
      "Conflict": { "description": "State or approval conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeV2" } } } },
      "BlockedExternal": { "description": "External runtime dependency unavailable", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelopeV2" } } } }
    },
    "securitySchemes": {
      "adminToken": { "type": "apiKey", "in": "header", "name": "authorization" },
      "desktopSignature": { "type": "apiKey", "in": "header", "name": "x-devbox-signature" }
    }
  }
}
