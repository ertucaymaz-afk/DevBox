{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/devapi-home", "destination": "/ecosystem-page.html" },
    { "source": "/devapi-api", "destination": "/ecosystem-page.html" },
    { "source": "/devapi-docs", "destination": "/ecosystem-page.html" },
    { "source": "/devapi-console", "destination": "/ecosystem-page.html" },
    { "source": "/devapi-status", "destination": "/ecosystem-page.html" },
    { "source": "/devapi-studio", "destination": "/ecosystem-page.html" },
    { "source": "/devapi-evolution", "destination": "/ecosystem-page.html" },
    { "source": "/devapi-workbench", "destination": "/ecosystem-page.html" },
    { "source": "/devapi-memory", "destination": "/ecosystem-page.html" },
    { "source": "/devapi-diagnostics", "destination": "/ecosystem-page.html" }
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()" },
      { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'" }
    ]
  }]
}
